{
  "name": "pi-subscription-panel",
  "version": "1.0.0",
  "description": "Read-only Pi Atelier subscription usage panel for Codex, Claude Code, Antigravity and native Anthropic OAuth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanonoir/pi-subscription-panel.git"
  },
  "homepage": "https://github.com/nanonoir/pi-subscription-panel#readme",
  "bugs": {
    "url": "https://github.com/nanonoir/pi-subscription-panel/issues"
  },
  "type": "module",
  "files": [
    "extensions/",
    "docs/images/pi-subscription-panel-showcase.gif",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-atelier",
    "subscription-panel",
    "subscription-quota"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.cjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "pi-atelier": "^0.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
