{
  "name": "pi-subscription-panel",
  "private": true,
  "version": "0.1.0",
  "description": "Read-only Pi Atelier subscription panel for Codex and native Anthropic OAuth usage",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-atelier",
    "subscription-panel",
    "subscription-quota"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.cjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "pi-atelier": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
